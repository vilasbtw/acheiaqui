# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Nunca commite o arquivo .env com valores reais.

# Connection string "Session pooler" (Supabase -> Connect). Senha só com letras e números.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SUA_SENHA@HOST_DO_PAINEL:5432/postgres

# Project URL e publishable (anon) key — Supabase -> Project Settings -> API
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# URLs do frontend autorizadas (CORS), separadas por vírgula, sem barra no final.
# Local: o endereço de onde você abre as páginas. Produção: a URL da Vercel/Netlify.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# Fase 4 — IA de categorização. Funciona com qualquer provedor de endpoint compatível com
# "chat/completions" que tenha plano gratuito. Sem estas 3 linhas, o sistema funciona normal,
# só que sem categoria automática. A chave NUNCA vai para o frontend nem para o Git.
# Exemplos de endereço (confirme na documentação do provedor):
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:   https://api.groq.com/openai/v1
# Modelo: copie da documentação do provedor o nome de um modelo pequeno e rápido
# (evite modelos "de raciocínio": são lentos e podem estourar o tempo limite de 8 s).
IA_API_KEY=
IA_BASE_URL=
IA_MODEL=
